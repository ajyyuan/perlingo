/dist/
/hosting/public/
/hosting/dist/
/hosting/.sites-runtime/
/hosting/.wrangler/
/hosting/.vinext/

# Ignore dependency symlinks as well as directories
**/node_modules

# Local Python source-check caches
__pycache__/

# Temporary full lemma audio batch downloads
/audio-generation/lemmas-library/*.zip

# Temporary row-example audio batch downloads
/audio-generation/lemma-row-library/*.zip

# Temporary full-reference audio batch downloads
/audio-generation/lemma-reference-library/*.zip

