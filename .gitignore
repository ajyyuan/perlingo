.DS_Store
node_modules/
*.tar.gz

# Supabase CLI cache
supabase/.temp/

# Temporary Azure download archives (recordings and ledgers are retained)
audio-generation/*.zip

# Local API credentials
.env
.env.*
!.env.example
perlingo-challenge/.cache/

# Local preview screenshots
/.cache/

